# ============================================================================
# CommuteIQ — Environment Variables (example)
# Copy this file to `.env.local` for local development.
# These values are injected automatically by `deploy.sh` on Vercel — a
# non-technical user never has to touch them.
# ============================================================================

# Google Maps Platform API key (server-side only — never exposed to the client).
GMAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Vercel KV connection (auto-injected by `vercel kv` provisioning on deploy).
# Leave blank locally to use the browser localStorage fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=
